public with sharing class AccountEnrichmentHandler {

    public static void handleAccounts(
        List<Account> newAccounts,
        Map<Id, Account> oldMap
    ) {

        Set<Id> accountIds = new Set<Id>();

        for (Account acc : newAccounts) {

            if (String.isNotBlank(acc.BillingCountry)) {

                if (oldMap == null) {

                    accountIds.add(acc.Id);

                } else {

                    Account oldAccount = oldMap.get(acc.Id);

                    if (oldAccount.BillingCountry != acc.BillingCountry) {

                        accountIds.add(acc.Id);
                    } 
                }
            }
        }

        if (!accountIds.isEmpty()) {

            System.enqueueJob(
                new AccountEnrichmentQueueable(accountIds)
            );
        }
    }
}
